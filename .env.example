# Copier ce fichier en .env.local et remplir avec les valeurs de ton projet Supabase
# (Project Settings > API). La clé "anon" est publique : elle est faite pour le navigateur.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Utilisé seulement par les scripts de base de données (jamais envoyé au navigateur)
DATABASE_URL=postgresql://postgres:MOT_DE_PASSE@db.xxxxxxxx.supabase.co:5432/postgres
